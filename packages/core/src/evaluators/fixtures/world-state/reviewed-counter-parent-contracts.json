          {
            "name": "fs.mkdir",
            "kind": "script",
            "path": "business",
            "requiredArgs": {
              "path": "string"
            },
            "script": "from pathlib import PurePosixPath\nargs=dict(args)\np=PurePosixPath(args[\"path\"])\nif '..' in p.parts: raise ValueError('PATH_NOT_ALLOWED')\nif p.is_absolute():\n    try: p=p.relative_to(\"/workspace\")\n    except ValueError: raise ValueError('PATH_NOT_ALLOWED')\nargs[\"path\"]=str(p)\nif args['path'] not in ['myapp','myapp/src','myapp/tests']: raise ValueError('WRONG_PATH')\nif args['path'] not in state['dirs']: state['dirs'].append(args['path'])\nstate.setdefault('createdDirs',{})[args['path'].replace('/','.')]=True\nfrom pathlib import Path\n(Path('/workspace')/args['path']).mkdir(parents=True,exist_ok=True)\nresult={'created':args['path']}",
            "description": "创建真实容器目录。 工作目录 /workspace，接受题面目录的相对路径、./ 写法及工作目录内绝对路径；不支持其他目录或 ..。"
