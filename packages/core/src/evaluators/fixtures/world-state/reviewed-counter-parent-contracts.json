            "name": "fs.write",
            "kind": "script",
            "path": "business",
            "requiredArgs": {
              "path": "string",
              "content": "string"
            },
            "script": "from pathlib import PurePosixPath\nargs=dict(args)\np=PurePosixPath(args[\"path\"])\nif '..' in p.parts: raise ValueError('PATH_NOT_ALLOWED')\nif p.is_absolute():\n    try: p=p.relative_to(\"/workspace\")\n    except ValueError: raise ValueError('PATH_NOT_ALLOWED')\nargs[\"path\"]=str(p)\nif args['path']!='myapp/package.json': raise ValueError('WRONG_PATH')\nimport json\nobj=json.loads(args['content'])\nif obj.get('name')!='myapp' or not isinstance(obj.get('scripts'),dict): raise ValueError('INVALID_PACKAGE')\nfrom pathlib import Path\n(Path('/workspace')/args['path']).write_text(args['content']); state['files'][args['path']]=args['content']; state['writes']+=1\nresult={'written':True}",
            "description": "写真实 package.json。 package name=myapp；content 是合法 JSON，name 为项目名，scripts 必须是对象；path 为 myapp/package.json，可用 ./ 或工作目录内绝对路径。"
          }
