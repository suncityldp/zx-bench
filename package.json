{
  "name": "zxbench-webui",
  "version": "0.2.9",
  "private": true,
  "description": "ZxBench Pro WebUI - 大模型评测系统",
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm -r run build",
    "build:web": "pnpm --filter web build",
    "build:server": "pnpm --filter server build",
    "lint": "pnpm -r run lint",
    "type-check": "pnpm -r run type-check",
    "pretest": "pnpm test:world-contracts && pnpm -r --filter \"./packages/*\" run build",
    "test": "vitest run",
    "test:deployment": "node --test scripts/seed-benchmark.test.mjs scripts/check-docker-images.test.mjs scripts/init-database.test.mjs",
    "bank:sync": "node scripts/seed-benchmark.mjs",
    "bank:check": "node scripts/seed-benchmark.mjs --check",
    "runtime:check": "node scripts/check-docker-images.mjs",
    "test:containers": "node scripts/test-containers.mjs",
    "test:isolation": "node scripts/test-containers.mjs --isolation --maxWorkers=1 --minWorkers=1",
    "test:observation": "node scripts/test-containers.mjs --observation --maxWorkers=1 --minWorkers=1",
    "test:pr-witness": "node scripts/test-containers.mjs --pr-witness --maxWorkers=1 --minWorkers=1",
    "freeze:pr-witness": "pnpm --filter @zxbench/core build && node scripts/freeze-pr-witness-development.mjs",
    "upgrade:pr-evidence": "pnpm --filter @zxbench/core build && node scripts/upgrade-pr-executable-evidence.mjs",
    "audit:adversarial": "pnpm --filter @zxbench/core build && node scripts/audit-deep-adversarial.mjs",
    "probe:observation-trust": "pnpm --filter @zxbench/core build && node scripts/probe-observation-trust.mjs",
    "gate:adversarial": "pnpm --filter @zxbench/core build && node scripts/audit-deep-adversarial.mjs --gate",
    "screen:discrimination": "pnpm --filter @zxbench/core build && node scripts/screen-challenge-discrimination.mjs",
    "screen:challenge-current": "pnpm --filter @zxbench/core build && node scripts/recompute-challenge-screening.mjs",
    "promote:challenge": "pnpm --filter @zxbench/core build && node scripts/promote-challenge-supplement.mjs",
    "audit:project-sample": "pnpm --filter @zxbench/core build && node scripts/audit-project-repair-sample.mjs",
    "eval:challenge-third": "pnpm --filter server exec tsx ../../packages/core/src/scripts/run-challenge-third-model.ts",
    "eval:challenge-third:continue": "pnpm --filter server exec tsx ../../packages/core/src/scripts/continue-challenge-third-model.ts",
    "eval:methods-v2": "pnpm --filter server exec tsx ../../packages/core/src/scripts/methods-v2.ts",
    "eval:methods-v2:test": "vitest run packages/core/src/evaluationLab/methodsV2",
    "eval:structural": "pnpm --filter server exec tsx ../../packages/core/src/scripts/structural-challenge.ts",
    "eval:structural:test": "vitest run packages/core/src/evaluationLab/structuralChallenge",
    "eval:structural:screen": "pnpm --filter server exec tsx ../../packages/core/src/scripts/screen-structural.ts",
    "eval:frontier": "pnpm --filter server exec tsx ../../packages/core/src/scripts/frontier-challenge.ts",
    "eval:frontier:test": "vitest run packages/core/src/evaluationLab/frontierChallenge",
    "eval:frontier:screen": "pnpm --filter server exec tsx ../../packages/core/src/scripts/screen-frontier.ts",
    "eval:maps": "pnpm --filter server exec tsx ../../packages/core/src/scripts/annihilating-maps.ts",
    "eval:exam": "pnpm --filter server exec tsx ../../packages/core/src/scripts/progressive-exam-budget-v2.ts",
    "eval:exam:test": "vitest run packages/core/src/evaluationLab/examPaper",
    "eval:exam:next": "pnpm --filter server exec tsx ../../packages/core/src/scripts/progressive-exam-expansion.ts",
    "eval:exam:next:test": "vitest run packages/core/src/evaluationLab/examExpansion/expansion.test.ts",
    "eval:exam:evidence": "pnpm --filter server exec tsx ../../packages/core/src/scripts/evidence-exam.ts",
    "eval:ultra:batch:test": "vitest run packages/core/src/evaluationLab/evidenceExam packages/core/src/evaluationLab/examExpansion/expansion.test.ts packages/core/src/evaluationLab/ultraMathRubric.test.ts packages/core/src/evaluationLab/ultraMathQuestions.test.ts packages/core/src/evaluationLab/ultraBatchRelease.test.ts",
    "eval:ultra:batch": "pnpm --filter server exec tsx ../../packages/core/src/scripts/ultra-batch.ts",
    "eval:ultra:test": "vitest run packages/core/src/evaluationLab/ultraMathRubric.test.ts",
    "eval:inspect": "pnpm --filter server exec tsx ../../packages/core/src/scripts/inspect-capability.ts",
    "db:generate": "pnpm --filter server prisma:generate",
    "db:push": "node scripts/init-database.mjs",
    "db:studio": "pnpm --filter server prisma:studio",
    "test:world-contracts": "node --test scripts/recovery-world-search.test.mjs scripts/tool-visible-contracts.test.mjs scripts/workflow-visible-contracts.test.mjs scripts/tool-content-delivery-review.test.mjs",
    "runtime:workflow": "node scripts/prepare-workflow-runtime.mjs",
    "test:workflow-containers": "node scripts/test-workflow-containers.mjs",
    "test:tool-containers": "pnpm -r --filter \"./packages/*\" run build && node scripts/test-tool-containers.mjs"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
