{
  "name": "zxbench-webui",
  "version": "0.1.0",
  "private": true,
  "description": "ZxBench Pro WebUI - 大模型评测系统",
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm -r run build",
    "build:web": "pnpm --filter web build",
    "build:server": "pnpm --filter server build",
    "lint": "pnpm -r run lint",
    "type-check": "pnpm -r run type-check",
    "pretest": "pnpm -r --filter \"./packages/*\" run build",
    "test": "vitest run",
    "db:generate": "pnpm --filter server prisma:generate",
    "db:push": "pnpm --filter server prisma:push",
    "db:studio": "pnpm --filter server prisma:studio"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
